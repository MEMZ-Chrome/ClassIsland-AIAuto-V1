<ci:SettingsPageBase x:Class="ClassIsland.Automation.V1.Views.SettingsPages.AutomationSettingsPage"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     mc:Ignorable="d">
    <Grid>
        <!-- 密码/TOTP 访问锁定遮罩层 -->
        <Border Name="LockOverlayBorder" Visibility="Collapsed"
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1" CornerRadius="12" Padding="28"
                MaxWidth="440" VerticalAlignment="Center" HorizontalAlignment="Center">            <StackPanel>
                <TextBlock Text="安全访问保护" FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="固定密码或 6 位动态验证码" FontSize="13"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox Name="UnlockPasswordBox" Margin="0,0,8,0"
                                     VerticalContentAlignment="Center" Height="32"/>
                        <Button Name="UnlockButton" Grid.Column="1" Content="解锁" Padding="16,4" Height="32"/>
                    </Grid>
                    <TextBlock Name="UnlockErrorTextBlock" FontSize="12" Visibility="Collapsed"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"/>
                </StackPanel>

                <TextBlock Name="LockHintTextBlock" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           Text="验证前页面不会锁定，TOTP 也不会生效。"/>
            </StackPanel>
        </Border>

        <!-- 主设置内容区域 -->
        <ScrollViewer Name="MainSettingsScrollViewer" Margin="16" Visibility="Visible">
            <!-- 不限制最大宽度：ClassIsland 1.x 没有统一的设置页宽度约束，
                 写死宽度会在宽窗口下留下大片空白。 -->
            <StackPanel HorizontalAlignment="Stretch">
                <TextBlock Text="IslandAgent设置" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="模型服务、偏好与安全防护" FontSize="12" Margin="0,2,0,16"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>

                <TabControl>
                    <!-- 选项卡 1：模型服务 -->
                    <TabItem Header="模型服务">
                        <StackPanel Margin="0,12,0,0">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="模型服务" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Name="AddProviderButton" Grid.Column="1" Content="+ 添加供应商" Padding="14,5"/>
                            </Grid>

                            <!-- 供应商卡片列表容器 -->
                            <StackPanel Name="ProvidersListContainer"/>
                        </StackPanel>
                    </TabItem>

                    <!-- 选项卡 2：高级偏好 -->
                    <TabItem Header="高级偏好">
                        <StackPanel Margin="0,12,0,0">
                            <!-- 功能权限开关 -->
                            <CheckBox Name="IsMemoryEnabledCheckBox" Content="启用长期记忆" IsChecked="True" Margin="0,0,0,8"/>
                            <CheckBox Name="IsCommandExecutionEnabledCheckBox" Content="允许 AI 执行命令行命令"/>
                            <TextBlock Text="开启后 AI 可执行终端指令，请确认信任当前模型。" FontSize="12"
                                       TextWrapping="Wrap" Margin="28,4,0,16"
                                       Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"/>

                            <!-- 工具调用轮数上限 -->
                            <TextBlock Text="工具调用轮数上限" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="MaxToolIterationsTextBox" Width="120" HorizontalAlignment="Left"
                                         VerticalContentAlignment="Center" Height="30"/>
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           Text="单次提问内 AI 最多连续调用工具的轮数，可填 1–50，超出后停止。数值越大越能完成复杂任务，API 调用与费用也越多。"/>
                            </Grid>

                            <!-- 自定义系统提示词 -->
                            <TextBlock Text="自定义系统提示词" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox Name="CustomPromptTextBox" AcceptsReturn="True" Height="88" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"/>

                            <!-- 长期记忆管理 -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="长期记忆" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Name="ClearMemoryButton" Grid.Column="1" Content="清空" Padding="10,3"/>
                            </Grid>
                            <TextBox Name="CustomMemoryTextBox" AcceptsReturn="True" Height="104" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </TabItem>

                    <!-- 选项卡 3：安全防护 -->
                    <TabItem Header="安全防护">
                        <StackPanel Margin="0,12,0,0">
                            <!-- 固定密码 -->
                            <Border Background="{DynamicResource MaterialDesignBackground}"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Name="PasswordStatusTextBlock" Text="当前状态：未设置固定密码（默认无密码）"
                                               FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox Name="NewPasswordBox" Margin="0,0,8,0"
                                                     VerticalContentAlignment="Center" Height="30"/>
                                        <Button Name="SavePasswordButton" Grid.Column="1" Margin="0,0,8,0"
                                                Content="更新密码" Padding="12,4"/>
                                        <Button Name="ClearPasswordButton" Grid.Column="2"
                                                Content="清除密码" Padding="12,4" Visibility="Collapsed"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- TOTP 动态口令 -->
                            <Border Background="{DynamicResource MaterialDesignBackground}"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Name="TotpStatusTextBlock" Text="当前状态：未启用 TOTP 动态口令"
                                               FontWeight="SemiBold" Margin="0,0,0,10"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Button Name="SetupTotpButton" Content="生成并配置 TOTP" Padding="12,4" Margin="0,0,8,0"/>
                                        <Button Name="DisableTotpButton" Content="关闭 TOTP 保护" Padding="12,4" Visibility="Collapsed"/>
                                    </StackPanel>

                                    <!-- TOTP 暂存与绑定配置卡片 -->
                                    <Border Name="TotpSetupCard" Visibility="Collapsed"
                                            Background="{DynamicResource MaterialDesignCardBackground}"
                                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                                            BorderThickness="1" CornerRadius="8" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="验证成功前 TOTP 不会生效，页面也不会被锁定。" FontSize="12"
                                                       TextWrapping="Wrap" Margin="0,0,0,14"
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>

                                            <!-- 密钥字符串 -->
                                            <TextBlock Text="密钥字符串" FontSize="12" Margin="0,0,0,6"
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Name="TotpSecretStringTextBox" IsReadOnly="True"
                                                         FontFamily="Consolas" FontSize="14"
                                                         Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                                                <Button Name="CopyTotpSecretButton" Grid.Column="1" Content="复制" Padding="10,4"/>
                                            </Grid>

                                            <!-- 二维码 -->
                                            <TextBlock Text="绑定二维码" FontSize="12" Margin="0,0,0,6"
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                            <Border Background="White" CornerRadius="8" HorizontalAlignment="Left"
                                                    Padding="8" Margin="0,0,0,14">
                                                <Image Name="TotpQrCodeImage" Width="160" Height="160"/>
                                            </Border>

                                            <!-- 激活验证 -->
                                            <TextBlock Text="输入 6 位验证码完成激活" FontSize="12" Margin="0,0,0,6"
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Name="TotpVerifyCodeTextBox" MaxLength="6" Margin="0,0,8,0"
                                                         VerticalContentAlignment="Center"/>
                                                <Button Name="VerifyAndActivateTotpButton" Grid.Column="1" Margin="0,0,8,0"
                                                        Content="激活" Padding="12,4"/>
                                                <Button Name="CancelPendingTotpButton" Grid.Column="2"
                                                        Content="取消" Padding="12,4"/>
                                            </Grid>
                                            <TextBlock Name="TotpVerifyResultTextBlock" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>
                </TabControl>

                <!-- 保存设置常驻按钮栏 -->
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Name="SaveButton" Content="保存" Padding="18,6" Margin="0,0,12,0"/>
                    <TextBlock Name="StatusTextBlock" VerticalAlignment="Center" Foreground="Green"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 供应商 添加/编辑 模态弹窗遮罩层 -->
        <Grid Name="ProviderDialogOverlay" Visibility="Collapsed" Background="#80000000">
            <Border Background="{DynamicResource MaterialDesignCardBackground}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1" CornerRadius="12" Padding="24"
                    Width="480" MaxHeight="620"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 弹窗标题与关闭 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="DialogTitleTextBlock" Text="添加供应商" FontSize="18" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Name="DialogCloseButton" Grid.Column="1" Content="关闭" Padding="8,4"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 弹窗表单滚动内容 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 预置快捷填入 -->
                            <TextBlock Text="预置模板" FontSize="12" Margin="0,0,0,6"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <WrapPanel Name="PresetButtonsWrapPanel" Margin="0,0,0,14"/>

                            <!-- 供应商别名 -->
                            <TextBlock Text="供应商别名" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox Name="DialogNameTextBox" Margin="0,0,0,14"/>

                            <!-- API 地址 -->
                            <TextBlock Text="API 地址" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox Name="DialogBaseUrlTextBox" Margin="0,0,0,14"/>

                            <!-- API 密钥 -->
                            <TextBlock Text="API 密钥" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <PasswordBox Name="DialogApiKeyPasswordBox" Margin="0,0,0,14"/>

                            <!-- 模型管理 -->
                            <Border Background="{DynamicResource MaterialDesignBackground}"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="模型列表" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button Name="DialogFetchModelsButton" Grid.Column="1" Content="自动获取" Padding="10,4"/>
                                    </Grid>

                                    <!-- 手动添加模型 -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Name="DialogNewModelTextBox" Margin="0,0,8,0"/>
                                        <Button Name="DialogAddModelButton" Grid.Column="1" Content="添加" Padding="12,4"/>
                                    </Grid>

                                    <!-- 弹窗中的模型列表展示 -->
                                    <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                                            BorderThickness="1" CornerRadius="6" Padding="6" MaxHeight="160">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel Name="DialogModelsContainer"/>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 底部保存/取消按钮 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                <Button Name="DialogCancelButton" Content="取消" Padding="16,6" Margin="0,0,10,0"/>
                                <Button Name="DialogSaveButton" Content="保存" Padding="20,6"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 浮动 Toast 轻提示 -->
        <Border Name="ToastBorder" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,20,0,0" CornerRadius="8"
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
                Padding="18,10">
            <TextBlock Name="ToastMessageTextBlock" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource MaterialDesignBody}"/>
        </Border>
    </Grid>
</ci:SettingsPageBase>
