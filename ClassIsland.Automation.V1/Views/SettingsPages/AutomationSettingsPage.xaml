<ci:SettingsPageBase x:Class="ClassIsland.Automation.V1.Views.SettingsPages.AutomationSettingsPage"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     mc:Ignorable="d"
                     Title="IslandAgent设置"
                     TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                     Background="{DynamicResource MaterialDesignPaper}"
                     FontFamily="{DynamicResource HarmonyOsSans}"
                     TextElement.FontWeight="Regular"
                     TextElement.FontSize="14"
                     TextOptions.TextFormattingMode="Ideal"
                     TextOptions.TextRenderingMode="Auto">
    <ci:SettingsPageBase.Resources>
        <!-- 预置模板胶囊：自绘模板以保持紧凑、无多余阴影 -->
        <Style x:Key="PresetChipButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChipBorder" CornerRadius="14" Padding="11,4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="BorderBrush"
                                        Value="{DynamicResource PrimaryHueMidBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ci:SettingsPageBase.Resources>

    <Grid>
        <!-- 密码/TOTP 访问锁定遮罩层 -->
        <materialDesign:Card Name="LockOverlayBorder" Visibility="Collapsed"
                             Foreground="{DynamicResource MaterialDesignBody}"
                             Padding="28" Margin="16" MaxWidth="420"
                             VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <materialDesign:PackIcon Kind="ShieldAccountOutline" Width="40" Height="40"
                                         HorizontalAlignment="Center" Margin="0,0,0,10"
                                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                <TextBlock Text="安全访问保护" Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Name="LockHintTextBlock" FontSize="12" TextWrapping="Wrap"
                           TextAlignment="Center" Opacity="0.7" Margin="0,0,0,20"
                           Foreground="{DynamicResource MaterialDesignBody}"
                           Text="当前设置页面已开启访问保护，请输入固定密码或 6 位 TOTP 动态验证码解锁。"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox Name="UnlockPasswordBox" Margin="0,0,8,0"
                                 Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                 materialDesign:HintAssist.Hint="固定密码或 6 位动态验证码"
                                 VerticalContentAlignment="Center"/>
                    <Button Name="UnlockButton" Grid.Column="1" VerticalAlignment="Center">
                        <ci:IconText Kind="Check" Text="解锁"/>
                    </Button>
                </Grid>

                <TextBlock Name="UnlockErrorTextBlock" FontSize="12" Visibility="Collapsed"
                           TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- 主设置内容区域（遵循 ClassIsland 1.x SettingsPageStackPanelStyle 规范） -->
        <ScrollViewer Name="MainSettingsScrollViewer" Visibility="Visible">
            <StackPanel Style="{StaticResource SettingsPageStackPanelStyle}">
                <TabControl HorizontalContentAlignment="Left">
                    <!-- 选项卡 1：模型服务 -->
                    <TabItem Header="模型服务">
                        <StackPanel Margin="0,12,0,0">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ci:IconText Kind="CloudOutline" Text="模型供应商" VerticalAlignment="Center"/>
                                <Button Name="AddProviderButton" Grid.Column="1">
                                    <ci:IconText Kind="Add" Text="添加供应商"/>
                                </Button>
                            </Grid>

                            <!-- 供应商卡片列表容器 -->
                            <StackPanel Name="ProvidersListContainer"/>
                        </StackPanel>
                    </TabItem>

                    <!-- 选项卡 2：高级偏好 -->
                    <TabItem Header="高级偏好">
                        <StackPanel Margin="0,12,0,0">
                            <!--
                              注意：ci:SettingsCard / ci:SettingsControl 是 UserControl，拥有独立 NameScope。
                              如果把带 Name 的控件塞进它们的 Switcher 属性，WPF 编译会报 MC3093。
                              因此这里统一采用与 SettingsCard 完全等价的 materialDesign:Card(Padding="12,10,16,10")
                              + Grid(左 SettingsControl HasSwitcher="False"、右命名控件) 结构。
                            -->

                            <!-- 功能与权限 -->
                            <ci:IconText Kind="LightningBoltOutline" Text="功能与权限" Margin="0,0,0,8"/>

                            <materialDesign:Card Padding="12,10,16,10" Margin="0,0,0,6"
                                                 Foreground="{DynamicResource MaterialDesignBody}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ci:SettingsControl IconGlyph="DatabaseOutline"
                                                        Foreground="{DynamicResource MaterialDesignBody}"
                                                        Header="启用长期记忆"
                                                        Description="开启后 AI 会在对话中自动参考并更新下方的长期记忆内容。"
                                                        HasSwitcher="False"/>
                                    <ToggleButton Name="IsMemoryEnabledCheckBox" Grid.Column="1"
                                                  Margin="6,0,0,0" VerticalAlignment="Center" IsChecked="True"/>
                                </Grid>
                            </materialDesign:Card>

                            <materialDesign:Card Padding="12,10,16,10" Margin="0,0,0,6"
                                                 Foreground="{DynamicResource MaterialDesignBody}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ci:SettingsControl IconGlyph="Code"
                                                        Foreground="{DynamicResource MaterialDesignBody}"
                                                        Header="允许 AI 执行命令行命令"
                                                        Description="开启后 AI 可调用系统终端执行命令，存在较高安全风险，请仅在信任当前模型时启用。"
                                                        HasSwitcher="False"/>
                                    <ToggleButton Name="IsCommandExecutionEnabledCheckBox" Grid.Column="1"
                                                  Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </materialDesign:Card>

                            <materialDesign:ColorZone Name="CommandWarningBanner" Background="#1AFF9800"
                                                      Margin="0,0,0,6" Visibility="Collapsed">
                                <DockPanel Margin="10,6">
                                    <materialDesign:PackIcon Kind="WarningOutline" Width="18" Height="18"
                                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="已开启命令行执行权限：AI 可直接运行本机终端指令，请确认信任当前模型并做好安全防护。"
                                               TextWrapping="Wrap" FontSize="12.5" VerticalAlignment="Center"/>
                                </DockPanel>
                            </materialDesign:ColorZone>

                            <materialDesign:Card Padding="12,10,16,10" Margin="0,0,0,6"
                                                 Foreground="{DynamicResource MaterialDesignBody}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ci:SettingsControl IconGlyph="Repeat"
                                                        Foreground="{DynamicResource MaterialDesignBody}"
                                                        Header="工具调用轮数上限"
                                                        Description="单次提问内 AI 最多连续调用工具的轮数（1–50）。数值越大越能完成复杂任务，API 调用与费用也越多。"
                                                        HasSwitcher="False"/>
                                    <ci:NumbericTextBox Name="MaxToolIterationsTextBox" Grid.Column="1"
                                                        MinValue="1" MaxValue="50" Precision="0"
                                                        Width="100" Margin="6,0,0,0" VerticalAlignment="Center"
                                                        materialDesign:TextFieldAssist.SuffixText="轮"
                                                        Foreground="{DynamicResource MaterialDesignBody}"/>
                                </Grid>
                            </materialDesign:Card>

                            <!-- 会话与通知 -->
                            <Separator Margin="0,16,0,8"/>
                            <ci:IconText Kind="ListBoxOutline" Text="会话与通知" Margin="0,0,0,8"/>

                            <materialDesign:Card Margin="0,0,0,6" Foreground="{DynamicResource MaterialDesignBody}">
                                <Expander Name="MultiSessionExpander" Background="Transparent" IsExpanded="True"
                                          TextBlock.Foreground="{DynamicResource MaterialDesignBody}">
                                    <Expander.Header>
                                        <Grid Margin="-12,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ci:SettingsControl IconGlyph="ViewQuiltOutline"
                                                                Foreground="{DynamicResource MaterialDesignBody}"
                                                                Header="启用多会话模式"
                                                                Description="聊天窗口左侧显示会话列表，各会话历史独立保存在插件目录 sessions.json 中（最多保留 30 个会话）。"
                                                                HasSwitcher="False"/>
                                            <ToggleButton Name="IsMultiSessionEnabledCheckBox" Grid.Column="1"
                                                          Margin="6,0,0,0" VerticalAlignment="Center" IsChecked="True"/>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Name="MultiSessionSubOptionsPanel" Margin="36,0,48,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ci:SettingsControl IconGlyph="DockWindow" IsCompact="True"
                                                                Foreground="{DynamicResource MaterialDesignBody}"
                                                                Header="打开窗口时默认展开会话列表"
                                                                Description="关闭后默认收起侧栏，需要时可点击窗口左上角按钮展开。"
                                                                HasSwitcher="False"/>
                                            <ToggleButton Name="SessionSidebarExpandedCheckBox" Grid.Column="1"
                                                          Margin="6,0,0,0" VerticalAlignment="Center" IsChecked="True"/>
                                        </Grid>
                                    </StackPanel>
                                </Expander>
                            </materialDesign:Card>

                            <materialDesign:Card Padding="12,10,16,10" Margin="0,0,0,6"
                                                 Foreground="{DynamicResource MaterialDesignBody}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ci:SettingsControl IconGlyph="NotePlusOutline"
                                                        Foreground="{DynamicResource MaterialDesignBody}"
                                                        Header="每次打开窗口时新建会话"
                                                        Description="开启后每次打开对话窗口自动开始新会话，关闭则继续上一次对话历史。"
                                                        HasSwitcher="False"/>
                                    <ToggleButton Name="NewSessionOnOpenCheckBox" Grid.Column="1"
                                                  Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </materialDesign:Card>

                            <materialDesign:Card Padding="12,10,16,10" Margin="0,0,0,6"
                                                 Foreground="{DynamicResource MaterialDesignBody}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ci:SettingsControl IconGlyph="AutoMode"
                                                        Foreground="{DynamicResource MaterialDesignBody}"
                                                        Header="AI 自动总结会话标题"
                                                        Description="每会话首次对话后由模型自动命名，会额外消耗少量 Token。"
                                                        HasSwitcher="False"/>
                                    <ToggleButton Name="AiSessionTitleCheckBox" Grid.Column="1"
                                                  Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </materialDesign:Card>

                            <materialDesign:Card Margin="0,0,0,6" Foreground="{DynamicResource MaterialDesignBody}">
                                <Expander Name="BackgroundNotificationExpander" Background="Transparent" IsExpanded="False"
                                          TextBlock.Foreground="{DynamicResource MaterialDesignBody}">
                                    <Expander.Header>
                                        <Grid Margin="-12,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ci:SettingsControl IconGlyph="BellNotificationOutline"
                                                                Foreground="{DynamicResource MaterialDesignBody}"
                                                                Header="后台任务完成时发送系统通知"
                                                                Description="关闭或隐藏对话窗口后，AI 后台任务完成时通过 ClassIsland 提醒通知您。"
                                                                HasSwitcher="False"/>
                                            <ToggleButton Name="BackgroundTaskNotificationCheckBox" Grid.Column="1"
                                                          Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Name="BackgroundNotificationSubOptionsPanel" Margin="36,0,48,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ci:SettingsControl IconGlyph="AutoMode" IsCompact="True"
                                                                Foreground="{DynamicResource MaterialDesignBody}"
                                                                Header="AI 单独生成单行通知摘要"
                                                                Description="开启后额外调用模型生成 10～20 字简短摘要，确保状态栏单行完整显示（关闭则直接截取原回复首行）。"
                                                                HasSwitcher="False"/>
                                            <ToggleButton Name="AiNotificationSummaryCheckBox" Grid.Column="1"
                                                          Margin="6,0,0,0" VerticalAlignment="Center" IsChecked="True"/>
                                        </Grid>
                                    </StackPanel>
                                </Expander>
                            </materialDesign:Card>

                            <!-- 提示词与记忆 -->
                            <Separator Margin="0,16,0,8"/>
                            <ci:IconText Kind="ScriptTextOutline" Text="提示词与记忆" Margin="0,0,0,8"/>

                            <materialDesign:Card Padding="12,10,16,12" Margin="0,0,0,6"
                                                 Foreground="{DynamicResource MaterialDesignBody}">
                                <StackPanel>
                                    <ci:SettingsControl IconGlyph="FileDocumentEditOutline"
                                                        Foreground="{DynamicResource MaterialDesignBody}"
                                                        Header="自定义系统提示词"
                                                        Description="附加到系统提示词中，用于定制 AI 的回复风格、称呼或课堂规则。"
                                                        HasSwitcher="False" Margin="0,0,0,10"/>
                                    <TextBox Name="CustomPromptTextBox"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="输入自定义系统提示词（留空使用默认）"
                                             AcceptsReturn="True" Height="96" TextWrapping="Wrap"
                                             VerticalContentAlignment="Top" Padding="10,8"
                                             VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Padding="12,10,16,12" Margin="0,0,0,6"
                                                 Foreground="{DynamicResource MaterialDesignBody}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ci:SettingsControl IconGlyph="DatabaseOutline"
                                                            Foreground="{DynamicResource MaterialDesignBody}"
                                                            Header="长期记忆内容"
                                                            Description="记录教室、作息或课表相关的长期信息，开启长期记忆后会自动提供给 AI。"
                                                            HasSwitcher="False"/>
                                        <Button Name="ClearMemoryButton" Grid.Column="1" Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Foreground="IndianRed">
                                            <ci:IconText Kind="Delete" Text="清空"/>
                                        </Button>
                                    </Grid>
                                    <TextBox Name="CustomMemoryTextBox"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="长期记忆内容（也可在对话中让 AI 自动更新）"
                                             AcceptsReturn="True" Height="108" TextWrapping="Wrap"
                                             VerticalContentAlignment="Top" Padding="10,8"
                                             VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </materialDesign:Card>
                        </StackPanel>
                    </TabItem>

                    <!-- 选项卡 3：安全防护 -->
                    <TabItem Header="安全防护">
                        <StackPanel Margin="0,12,0,0">
                            <ci:IconText Kind="SecurityAccountOutline" Text="访问保护" Margin="0,0,0,8"/>

                            <!-- 固定密码 -->
                            <materialDesign:Card Padding="12,10,16,12" Margin="0,0,0,6"
                                                 Foreground="{DynamicResource MaterialDesignBody}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ci:SettingsControl IconGlyph="PasswordOutline"
                                                            Foreground="{DynamicResource MaterialDesignBody}"
                                                            Header="固定密码"
                                                            Description="设置访问保护密码，打开设置页时需要验证，同时阻止 AI 修改敏感设置。"
                                                            HasSwitcher="False"/>
                                        <Button Name="ClearPasswordButton" Grid.Column="1" Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Foreground="IndianRed" Visibility="Collapsed">
                                            <ci:IconText Kind="Clear" Text="清除密码"/>
                                        </Button>
                                    </Grid>

                                    <TextBlock Name="PasswordStatusTextBlock"
                                               Text="当前状态：未设置固定密码（默认无密码）"
                                               FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                                               Margin="24,4,0,10"/>

                                    <Grid Margin="24,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox Name="NewPasswordBox" Margin="0,0,8,0"
                                                     Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                                     materialDesign:HintAssist.Hint="输入新密码（留空更新则清除密码）"
                                                     VerticalContentAlignment="Center"/>
                                        <Button Name="SavePasswordButton" Grid.Column="1" VerticalAlignment="Center">
                                            <ci:IconText Kind="ContentSave" Text="更新密码"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- TOTP 动态口令 -->
                            <materialDesign:Card Margin="0,0,0,6" Foreground="{DynamicResource MaterialDesignBody}">
                                <Expander Name="TotpExpander" Background="Transparent" IsExpanded="True"
                                          TextBlock.Foreground="{DynamicResource MaterialDesignBody}">
                                    <Expander.Header>
                                        <Grid Margin="-12,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ci:SettingsControl IconGlyph="TimerSyncOutline"
                                                                Foreground="{DynamicResource MaterialDesignBody}"
                                                                Header="TOTP 动态口令"
                                                                Description="使用手机或手环的验证器 App（如 Microsoft Authenticator）生成 6 位动态验证码。"
                                                                HasSwitcher="False"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        Margin="6,0,0,0" VerticalAlignment="Center">
                                                <Button Name="SetupTotpButton"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        Content="生成并配置 TOTP"/>
                                                <Button Name="DisableTotpButton"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        Foreground="IndianRed" Content="关闭 TOTP"
                                                        Margin="4,0,0,0" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Margin="36,0,24,12">
                                        <TextBlock Name="TotpStatusTextBlock"
                                                   Text="当前状态：未启用 TOTP 动态口令"
                                                   FontSize="12.5" Opacity="0.8" TextWrapping="Wrap"
                                                   Margin="0,0,0,8"/>

                                        <!-- TOTP 暂存与绑定配置区域 -->
                                        <Border Name="TotpSetupCard" Visibility="Collapsed"
                                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,4,0,0">
                                            <StackPanel>
                                                <materialDesign:ColorZone Background="{DynamicResource MaterialDesignToolBarBackground}"
                                                                          CornerRadius="4" Margin="0,0,0,14">
                                                    <DockPanel Margin="10,6">
                                                        <materialDesign:PackIcon Kind="InfoCircleOutline" Width="18" Height="18"
                                                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="验证成功前 TOTP 不会生效，页面也不会被锁定。"
                                                                   FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                </materialDesign:ColorZone>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 二维码 -->
                                                    <StackPanel Grid.Column="0" Margin="0,0,18,0" VerticalAlignment="Top">
                                                        <Border Background="White" CornerRadius="8" Padding="8">
                                                            <Image Name="TotpQrCodeImage" Width="156" Height="156"/>
                                                        </Border>
                                                        <TextBlock Text="扫码绑定验证器" FontSize="11.5" Opacity="0.65"
                                                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                    </StackPanel>

                                                    <!-- 密钥与验证 -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <Grid Margin="0,0,0,14">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Name="TotpSecretStringTextBox" IsReadOnly="True"
                                                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                                     materialDesign:HintAssist.Hint="密钥字符串"
                                                                     FontFamily="Consolas" FontSize="13.5"
                                                                     Margin="0,0,8,0"/>
                                                            <Button Name="CopyTotpSecretButton" Grid.Column="1"
                                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                                    VerticalAlignment="Bottom">
                                                                <ci:IconText Kind="ContentCopy" Text="复制"/>
                                                            </Button>
                                                        </Grid>

                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Name="TotpVerifyCodeTextBox" MaxLength="6"
                                                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                                     materialDesign:HintAssist.Hint="输入 6 位验证码激活"
                                                                     Margin="0,0,8,0"/>
                                                            <Button Name="VerifyAndActivateTotpButton" Grid.Column="1"
                                                                    Margin="0,0,6,0" VerticalAlignment="Bottom">
                                                                <ci:IconText Kind="Check" Text="激活"/>
                                                            </Button>
                                                            <Button Name="CancelPendingTotpButton" Grid.Column="2"
                                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                                    Content="取消" VerticalAlignment="Bottom"/>
                                                        </Grid>

                                                        <TextBlock Name="TotpVerifyResultTextBlock" FontSize="12"
                                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Expander>
                            </materialDesign:Card>
                        </StackPanel>
                    </TabItem>
                </TabControl>

                <!-- 底部状态与立即保存栏 -->
                <Separator Margin="0,16,0,8"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Name="StatusTextBlock" VerticalAlignment="Center" FontSize="12" Opacity="0.7"
                               Text="所有更改均会自动保存"/>
                    <Button Name="SaveButton" Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}">
                        <ci:IconText Kind="ContentSave" Text="立即保存"/>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 供应商 添加/编辑 模态弹窗遮罩层 -->
        <Grid Name="ProviderDialogOverlay" Visibility="Collapsed" Background="#8C000000">
            <materialDesign:Card Width="520" MaxHeight="660"
                                 Background="{DynamicResource MaterialDesignPaper}"
                                 Foreground="{DynamicResource MaterialDesignBody}"
                                 materialDesign:ElevationAssist.Elevation="Dp8"
                                 VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题区 -->
                    <Grid Grid.Row="0" Margin="20,16,12,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Name="DialogTitleTextBlock" Text="添加供应商"
                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                            <TextBlock Name="DialogSubtitleTextBlock" Margin="0,3,0,0" FontSize="12" Opacity="0.65"
                                       TextWrapping="Wrap"
                                       Text="填好别名、地址和密钥就能用。预置模板只填地址，密钥要自己填。"/>
                        </StackPanel>
                        <Button Name="DialogCloseButton" Grid.Column="1"
                                Style="{StaticResource MaterialDesignToolForegroundButton}"
                                Content="{materialDesign:PackIcon Close, Size=18}"
                                VerticalAlignment="Top" ToolTip="关闭"/>
                    </Grid>

                    <Separator Grid.Row="1" Margin="0"/>

                    <!-- 表单区 -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,14,20,10">
                            <TextBlock Text="快速填充" FontSize="11.5" Opacity="0.65" Margin="0,0,0,6"/>
                            <WrapPanel Name="PresetButtonsWrapPanel" Margin="0,0,0,10"/>

                            <TextBox Name="DialogNameTextBox"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     materialDesign:HintAssist.Hint="供应商别名（例如：DeepSeek）"
                                     Margin="0,0,0,12"/>

                            <TextBox Name="DialogBaseUrlTextBox"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     materialDesign:HintAssist.Hint="API 地址（例如：https://api.deepseek.com）"/>
                            <TextBlock Text="可以不写 /v1，请求失败时会自动补上再试一次。" FontSize="11"
                                       Opacity="0.55" Margin="0,4,0,12" TextWrapping="Wrap"/>

                            <PasswordBox Name="DialogApiKeyPasswordBox"
                                         Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                         materialDesign:HintAssist.Hint="API 密钥（sk-...）"
                                         Margin="0,0,0,16"/>

                            <!-- 模型列表区 -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="模型列表" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                                <Button Name="DialogFetchModelsButton" Grid.Column="1"
                                        Style="{StaticResource MaterialDesignFlatButton}" Padding="8,2">
                                    <ci:IconText Kind="Refresh" Text="从接口获取"/>
                                </Button>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="DialogNewModelTextBox"
                                         materialDesign:HintAssist.Hint="手动输入模型名，按回车添加"
                                         VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                <Button Name="DialogAddModelButton" Grid.Column="1"
                                        Style="{StaticResource MaterialDesignFlatButton}" Padding="10,2">
                                    <ci:IconText Kind="Add" Text="添加"/>
                                </Button>
                            </Grid>

                            <Border MaxHeight="150" CornerRadius="6" Padding="6,4"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
                                    Background="{DynamicResource MaterialDesignCardBackground}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Name="DialogModelsContainer" Margin="2"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 底部操作区：错误提示在左，按钮固定在右下角 -->
                    <Border Grid.Row="3" BorderThickness="0,1,0,0" Padding="20,10,16,12"
                            BorderBrush="{DynamicResource MaterialDesignDivider}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Name="DialogErrorTextBlock" Visibility="Collapsed"
                                       FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Margin="0,0,12,0"
                                       Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Name="DialogCancelButton" Content="取消"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Margin="0,0,8,0"/>
                                <Button Name="DialogSaveButton">
                                    <ci:IconText Kind="Check" Text="保存"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- MaterialDesign 原生 Snackbar 轻提示 -->
        <materialDesign:Snackbar Name="PageSnackbar"
                                 VerticalAlignment="Bottom"
                                 HorizontalAlignment="Center"
                                 Margin="0,0,0,12"/>
    </Grid>
</ci:SettingsPageBase>
