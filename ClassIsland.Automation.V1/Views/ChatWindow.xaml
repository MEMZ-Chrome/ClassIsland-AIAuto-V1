<ci:MyWindow x:Class="ClassIsland.Automation.V1.Views.ChatWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:models="clr-namespace:ClassIsland.Automation.Core.Models"
             xmlns:mdXaml="clr-namespace:MdXaml;assembly=MdXaml"
             Title="AI 助手" Width="760" Height="720"
             MinWidth="540" MinHeight="480"
             WindowStartupLocation="CenterScreen"
             Background="{DynamicResource MaterialDesignPaper}"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             FontFamily="{DynamicResource HarmonyOsSans}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="14"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto">
    <ci:MyWindow.Resources>
        <!-- 会话条目容器：悬停高亮，自动跟随深浅主题 -->
        <Style x:Key="SessionItemBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,0,6,0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MaterialDesignDivider}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </ci:MyWindow.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 会话列表侧栏（仅多会话模式显示，可折叠） -->
        <Border Name="SessionSidebarBorder" Width="216" Margin="0,0,12,0" Visibility="Collapsed"
                CornerRadius="12"
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1"
                Padding="8,10,8,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 头部：图标 + 小标题 + 计数胶囊，右侧新建与收起按钮 -->
                <Grid Grid.Row="0" Margin="6,0,2,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ListBoxOutline" Width="15" Height="15"
                                                 Opacity="0.65" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="会话列表" FontSize="12" FontWeight="SemiBold" Opacity="0.75"
                                   VerticalAlignment="Center"/>
                        <Border CornerRadius="8" Padding="6,1" Margin="6,0,0,0"
                                Background="{DynamicResource MaterialDesignDivider}" VerticalAlignment="Center">
                            <TextBlock Name="SessionCountText" Text="0" FontSize="11" Opacity="0.85"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <Button Name="SidebarNewSessionButton" Grid.Column="1"
                            Width="26" Height="26" Padding="0"
                            Style="{StaticResource MaterialDesignToolForegroundButton}"
                            Content="{materialDesign:PackIcon Add, Size=16}"
                            ToolTip="新建会话"/>
                    <Button Name="SidebarCollapseButton" Grid.Column="2"
                            Width="26" Height="26" Padding="0" Margin="2,0,0,0"
                            Style="{StaticResource MaterialDesignToolForegroundButton}"
                            Content="{materialDesign:PackIcon ArrowLeft, Size=16}"
                            ToolTip="收起会话列表"/>
                </Grid>

                <Separator Grid.Row="1" Margin="4,0,4,6" Opacity="0.6"/>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Name="SessionListStackPanel"/>
                </ScrollViewer>

                <!-- 空状态 -->
                <StackPanel Name="SessionEmptyState" Grid.Row="2" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Visibility="Collapsed">
                    <materialDesign:PackIcon Kind="MessageAlertOutline" Width="28" Height="28"
                                             HorizontalAlignment="Center" Opacity="0.3"/>
                    <TextBlock Text="还没有会话" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.45"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 右侧主对话区 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部栏：展开侧栏按钮、标题与模型切换器 -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 侧栏收起后，展开按钮停在左缘 -->
                <Button Name="SidebarToggleButton" Grid.Column="0"
                        Width="32" Height="32" Padding="0"
                        Style="{StaticResource MaterialDesignToolForegroundButton}"
                        Content="{materialDesign:PackIcon Menu, Size=20}"
                        ToolTip="展开会话列表" VerticalAlignment="Center"
                        Margin="0,0,8,0" Visibility="Collapsed"/>

                <!-- AI 图标徽标 -->
                <Border Grid.Column="1" Width="36" Height="36" CornerRadius="10"
                        Background="{DynamicResource MaterialDesignCardBackground}"
                        BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
                        VerticalAlignment="Center" Margin="0,0,10,0">
                    <materialDesign:PackIcon Kind="RobotOutline" Width="20" Height="20"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="AI 助手" Style="{StaticResource MaterialDesignHeadline6TextBlock}" FontSize="17"/>
                    <TextBlock Text="连续智能调课、课表问答与设置调整" FontSize="12"
                               Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.65" Margin="0,1,0,0"/>
                </StackPanel>

                <!-- 右侧：新建会话（单会话模式可见） + 模型选择胶囊 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="NewSessionButton"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Margin="0,0,8,0" VerticalAlignment="Center" Padding="10,4">
                        <ci:IconText Kind="Add" Text="新建会话"/>
                    </Button>

                    <Border Background="{DynamicResource MaterialDesignCardBackground}"
                            BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
                            CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CloudOutline" Width="16" Height="16"
                                                     Opacity="0.7" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Name="ModelSelectComboBox" MinWidth="170" MaxWidth="240"
                                      VerticalAlignment="Center" BorderThickness="0"
                                      materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                      Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 消息历史对话流 -->
            <Border Grid.Row="1"
                    BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
                    CornerRadius="12"
                    Background="{DynamicResource MaterialDesignCardBackground}">
                <ScrollViewer Name="ChatScrollViewer" HorizontalScrollBarVisibility="Disabled" Padding="14,10">
                    <ItemsControl Name="MessagesItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ChatMessageItem}">
                                <Grid Margin="0,6">
                                    <!-- 用户消息气泡（右对齐） -->
                                    <StackPanel HorizontalAlignment="Right" MaxWidth="480" Margin="36,0,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding TimeString}" FontSize="11" Opacity="0.6"
                                                   Foreground="{DynamicResource MaterialDesignBody}"
                                                   HorizontalAlignment="Right" Margin="0,0,4,3">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TimeString}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border Background="{DynamicResource PrimaryHueMidBrush}"
                                                CornerRadius="14,14,3,14" Padding="13,9">
                                            <TextBox Text="{Binding Content, Mode=OneWay}" IsReadOnly="True"
                                                     TextWrapping="Wrap" BorderThickness="0"
                                                     Background="Transparent" Padding="0"
                                                     materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                                     Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                                                     FontSize="14" Cursor="Arrow"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- AI 助手消息气泡（左对齐） -->
                                    <StackPanel HorizontalAlignment="Left" MaxWidth="520" Margin="0,0,36,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <StackPanel Orientation="Horizontal" Margin="4,0,0,4">
                                            <materialDesign:PackIcon Kind="RobotOutline" Width="15" Height="15"
                                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="AI 助手" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{DynamicResource MaterialDesignBody}"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding TimeString}" FontSize="11"
                                                       Foreground="{DynamicResource MaterialDesignBody}"
                                                       Opacity="0.6" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TimeString}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ProgressBar IsIndeterminate="True" Width="13" Height="13"
                                                         VerticalAlignment="Center">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar"
                                                           BasedOn="{StaticResource MaterialDesignCircularProgressBar}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsThinking}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                        </StackPanel>

                                        <Border Background="{DynamicResource MaterialDesignPaper}"
                                                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
                                                CornerRadius="14,14,14,3" Padding="14,10">
                                            <StackPanel>
                                                <!-- 工具调用胶囊徽标 -->
                                                <ItemsControl ItemsSource="{Binding ToolBadges}" Margin="0,0,0,4">
                                                    <ItemsControl.Style>
                                                        <Style TargetType="ItemsControl">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasToolBadges}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ItemsControl.Style>
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                                    BorderThickness="1" CornerRadius="10"
                                                                    Padding="8,3" Margin="0,0,6,4">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon Kind="WrenchCheckOutline"
                                                                                             Width="12" Height="12"
                                                                                             Opacity="0.7"
                                                                                             VerticalAlignment="Center"
                                                                                             Margin="0,0,4,0"/>
                                                                    <TextBlock Text="{Binding}" FontSize="11"
                                                                               Foreground="{DynamicResource MaterialDesignBody}"
                                                                               Opacity="0.8" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Markdown 富文本 -->
                                                <mdXaml:MarkdownScrollViewer
                                                    Markdown="{Binding Content}"
                                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                    IsToolBarVisible="False"
                                                    Background="Transparent"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- 系统消息（居中胶囊） -->
                                    <StackPanel HorizontalAlignment="Center" Margin="0,4">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border Background="{DynamicResource MaterialDesignPaper}"
                                                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
                                                CornerRadius="12" Padding="12,5">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="InfoCircleOutline" Width="14" Height="14"
                                                                         Opacity="0.75" VerticalAlignment="Center"
                                                                         Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Content}" FontSize="11.5"
                                                           Foreground="{DynamicResource MaterialDesignBody}"
                                                           Opacity="0.8" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 底部一体化输入区卡片（附件工具栏 + 输入框 + 发送按钮） -->
            <Border Grid.Row="2" Margin="0,10,0,0"
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
                    CornerRadius="12" Padding="10,8">
                <StackPanel>
                    <!-- 附件工具栏 -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Name="SelectImageButton" Grid.Column="0"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Height="26" Padding="8,2">
                            <ci:IconText Kind="Image" Text="添加图片"/>
                        </Button>
                        <TextBlock Name="ImageStatusTextBlock" Grid.Column="1"
                                   VerticalAlignment="Center" FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.65"
                                   Text="未选择图片，可直接把文件拖进窗口" Margin="8,0,8,0"/>
                        <Button Name="ClearImageButton" Grid.Column="2"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="IndianRed" Visibility="Collapsed"
                                Height="26" Padding="8,2">
                            <ci:IconText Kind="Clear" Text="清除"/>
                        </Button>
                    </Grid>

                    <!-- 输入与发送 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <TextBox Name="InputTextBox"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="输入消息（Enter 发送，Shift + Enter 换行）..."
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     MinHeight="38" MaxHeight="120"
                                     VerticalContentAlignment="Center" Padding="10,7"/>
                            <TextBlock Name="InputWatermarkTextBlock" Visibility="Collapsed"/>
                        </Grid>
                        <Button Name="SendButton" Grid.Column="1" Margin="8,0,0,0"
                                Height="38" Padding="16,0" VerticalAlignment="Bottom">
                            <ci:IconText Kind="ArrowRight" Text="发送"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 拖拽提示遮罩层 -->
        <Grid Name="DropOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" IsHitTestVisible="False"
              Background="{DynamicResource MaterialDesignPaper}">
            <Rectangle Margin="8" RadiusX="14" RadiusY="14" StrokeThickness="1.5"
                       StrokeDashArray="4 3" Stroke="{DynamicResource PrimaryHueMidBrush}" Opacity="0.75"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="UploadOutline" Width="42" Height="42"
                                         HorizontalAlignment="Center"
                                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                <TextBlock Text="松开以添加文件" Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                           Margin="0,10,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="图片会作为附件发送，文本文件的内容会填进输入框" FontSize="12" Margin="0,4,0,0"
                           HorizontalAlignment="Center" Opacity="0.65"
                           Foreground="{DynamicResource MaterialDesignBody}"/>
            </StackPanel>
        </Grid>
    </Grid>
</ci:MyWindow>
