<ci:SettingsPageBase x:Class="ClassIsland.Automation.V1.Views.SettingsPages.AutomationSettingsPage"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     mc:Ignorable="d"
                     TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                     Background="{DynamicResource MaterialDesignPaper}">
    <ci:SettingsPageBase.Resources>
        <!-- 预置模板胶囊：自绘模板是为了不继承 MaterialDesign 的按钮内边距与阴影 -->
        <Style x:Key="PresetChipButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChipBorder" CornerRadius="12" Padding="11,5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="BorderBrush"
                                        Value="{DynamicResource MaterialDesignBody}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ci:SettingsPageBase.Resources>
    <Grid>
        <!-- 密码/TOTP 访问锁定遮罩层 -->
        <Border Name="LockOverlayBorder" Visibility="Collapsed"
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1" CornerRadius="12" Padding="28"
                MaxWidth="440" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="安全访问保护" FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="固定密码或 6 位动态验证码" FontSize="13" Opacity="0.7"
                               Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox Name="UnlockPasswordBox" Margin="0,0,8,0"
                                     VerticalContentAlignment="Center" Height="32"/>
                        <Button Name="UnlockButton" Grid.Column="1" Content="解锁" Padding="16,4" Height="32"/>
                    </Grid>
                    <TextBlock Name="UnlockErrorTextBlock" FontSize="12" Visibility="Collapsed"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"/>
                </StackPanel>

                <TextBlock Name="LockHintTextBlock" FontSize="12" TextWrapping="Wrap" Opacity="0.7"
                           Foreground="{DynamicResource MaterialDesignBody}"
                           Text="验证前页面不会锁定，TOTP 也不会生效。"/>
            </StackPanel>
        </Border>

        <!-- 主设置内容区域 -->
        <ScrollViewer Name="MainSettingsScrollViewer" Margin="16" Visibility="Visible">
            <!-- 不限制最大宽度：ClassIsland 1.x 没有统一的设置页宽度约束，
                 写死宽度会在宽窗口下留下大片空白。 -->
            <StackPanel HorizontalAlignment="Stretch">
                <TextBlock Text="IslandAgent设置" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="模型服务、偏好与安全防护" FontSize="12" Margin="0,2,0,16"
                           Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.7"/>

                <TabControl>
                    <!-- 选项卡 1：模型服务 -->
                    <TabItem Header="模型服务">
                        <StackPanel Margin="0,12,0,0">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="模型服务" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Name="AddProviderButton" Grid.Column="1" Content="+ 添加供应商" Padding="14,5"/>
                            </Grid>

                            <!-- 供应商卡片列表容器 -->
                            <StackPanel Name="ProvidersListContainer"/>
                        </StackPanel>
                    </TabItem>

                    <!-- 选项卡 2：高级偏好 -->
                    <TabItem Header="高级偏好">
                        <StackPanel Margin="0,12,0,0">
                            <!-- 功能权限开关 -->
                            <CheckBox Name="IsMemoryEnabledCheckBox" Content="启用长期记忆" IsChecked="True" Margin="0,0,0,8"/>
                            <CheckBox Name="IsCommandExecutionEnabledCheckBox" Content="允许 AI 执行命令行命令"/>
                            <TextBlock Text="开启后 AI 可执行终端指令，请确认信任当前模型。" FontSize="12"
                                       TextWrapping="Wrap" Margin="28,4,0,16"
                                       Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"/>

                            <!-- 会话管理 -->
                            <TextBlock Text="会话管理" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <CheckBox Name="IsMultiSessionEnabledCheckBox"
                                      Content="启用多会话模式（聊天窗口左侧显示会话列表，各会话历史独立）" IsChecked="True" Margin="0,0,0,8"/>
                            <CheckBox Name="SessionSidebarExpandedCheckBox" Margin="28,0,0,8"
                                      Content="打开窗口时默认展开会话列表（关闭后默认收起，点左上角按钮展开）"
                                      IsChecked="True"/>
                            <CheckBox Name="NewSessionOnOpenCheckBox"
                                      Content="每次打开对话窗口时新建会话（关闭则继续上一次会话）"/>
                            <CheckBox Name="AiSessionTitleCheckBox"
                                      Content="会话标题由 AI 总结生成（每会话首次对话后自动命名，额外消耗少量 token）"/>
                            <CheckBox Name="BackgroundTaskNotificationCheckBox"
                                      Content="后台任务完成时发送系统通知"/>
                            <TextBlock Text="对话历史保存在本机插件目录的 sessions.json 中，最多保留最近 30 个会话；关闭多会话模式后仍按单会话继续使用最近一次历史。"
                                       FontSize="12" TextWrapping="Wrap" Margin="28,4,0,16"
                                       Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.7"/>

                            <!-- 工具调用轮数上限 -->
                            <TextBlock Text="工具调用轮数上限" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="MaxToolIterationsTextBox" Width="120" HorizontalAlignment="Left"
                                         VerticalContentAlignment="Center" Height="30"/>
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                           FontSize="12" TextWrapping="Wrap" Opacity="0.7"
                                           Foreground="{DynamicResource MaterialDesignBody}"
                                           Text="单次提问内 AI 最多连续调用工具的轮数，可填 1–50，超出后停止。数值越大越能完成复杂任务，API 调用与费用也越多。"/>
                            </Grid>

                            <!-- 自定义系统提示词 -->
                            <TextBlock Text="自定义系统提示词" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox Name="CustomPromptTextBox" AcceptsReturn="True" Height="88" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"/>

                            <!-- 长期记忆管理 -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="长期记忆" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Name="ClearMemoryButton" Grid.Column="1" Content="清空" Padding="10,3"/>
                            </Grid>
                            <TextBox Name="CustomMemoryTextBox" AcceptsReturn="True" Height="104" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </TabItem>

                    <!-- 选项卡 3：安全防护 -->
                    <TabItem Header="安全防护">
                        <StackPanel Margin="0,12,0,0">
                            <!-- 固定密码 -->
                            <Border Background="{DynamicResource MaterialDesignBackground}"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Name="PasswordStatusTextBlock" Text="当前状态：未设置固定密码（默认无密码）"
                                               FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox Name="NewPasswordBox" Margin="0,0,8,0"
                                                     VerticalContentAlignment="Center" Height="30"/>
                                        <Button Name="SavePasswordButton" Grid.Column="1" Margin="0,0,8,0"
                                                Content="更新密码" Padding="12,4"/>
                                        <Button Name="ClearPasswordButton" Grid.Column="2"
                                                Content="清除密码" Padding="12,4" Visibility="Collapsed"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- TOTP 动态口令 -->
                            <Border Background="{DynamicResource MaterialDesignBackground}"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Name="TotpStatusTextBlock" Text="当前状态：未启用 TOTP 动态口令"
                                               FontWeight="SemiBold" Margin="0,0,0,10"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Button Name="SetupTotpButton" Content="生成并配置 TOTP" Padding="12,4" Margin="0,0,8,0"/>
                                        <Button Name="DisableTotpButton" Content="关闭 TOTP 保护" Padding="12,4" Visibility="Collapsed"/>
                                    </StackPanel>

                                    <!-- TOTP 暂存与绑定配置卡片 -->
                                    <Border Name="TotpSetupCard" Visibility="Collapsed"
                                            Background="{DynamicResource MaterialDesignCardBackground}"
                                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                                            BorderThickness="1" CornerRadius="8" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="验证成功前 TOTP 不会生效，页面也不会被锁定。" FontSize="12"
                                                       TextWrapping="Wrap" Margin="0,0,0,14"
                                                       Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.7"/>

                                            <!-- 密钥字符串 -->
                                            <TextBlock Text="密钥字符串" FontSize="12" Margin="0,0,0,6"
                                                       Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.7"/>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Name="TotpSecretStringTextBox" IsReadOnly="True"
                                                         FontFamily="Consolas" FontSize="14"
                                                         Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                                                <Button Name="CopyTotpSecretButton" Grid.Column="1" Content="复制" Padding="10,4"/>
                                            </Grid>

                                            <!-- 二维码 -->
                                            <TextBlock Text="绑定二维码" FontSize="12" Margin="0,0,0,6"
                                                       Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.7"/>
                                            <Border Background="White" CornerRadius="8" HorizontalAlignment="Left"
                                                    Padding="8" Margin="0,0,0,14">
                                                <Image Name="TotpQrCodeImage" Width="160" Height="160"/>
                                            </Border>

                                            <!-- 激活验证 -->
                                            <TextBlock Text="输入 6 位验证码完成激活" FontSize="12" Margin="0,0,0,6"
                                                       Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.7"/>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Name="TotpVerifyCodeTextBox" MaxLength="6" Margin="0,0,8,0"
                                                         VerticalContentAlignment="Center"/>
                                                <Button Name="VerifyAndActivateTotpButton" Grid.Column="1" Margin="0,0,8,0"
                                                        Content="激活" Padding="12,4"/>
                                                <Button Name="CancelPendingTotpButton" Grid.Column="2"
                                                        Content="取消" Padding="12,4"/>
                                            </Grid>
                                            <TextBlock Name="TotpVerifyResultTextBlock" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>
                </TabControl>

                <!-- 保存设置常驻按钮栏 -->
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Name="SaveButton" Content="保存" Padding="18,6" Margin="0,0,12,0"/>
                    <TextBlock Name="StatusTextBlock" VerticalAlignment="Center" Opacity="0.7"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 供应商 添加/编辑 模态弹窗遮罩层 -->
        <Grid Name="ProviderDialogOverlay" Visibility="Collapsed" Background="#8C000000">
            <Border Width="520" MaxHeight="660" CornerRadius="16"
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="4" Direction="270" Opacity="0.22" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题区：标题 + 一句话说明，右上角关闭 -->
                    <Grid Grid.Row="0" Margin="22,18,14,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Name="DialogTitleTextBlock" Text="添加供应商" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Name="DialogSubtitleTextBlock" Margin="0,3,0,0" FontSize="12" Opacity="0.55"
                                       TextWrapping="Wrap"
                                       Text="填好别名、地址和密钥就能用。预置模板只填地址，密钥要自己填。"/>
                        </StackPanel>
                        <Button Name="DialogCloseButton" Grid.Column="1" Width="28" Height="28" Padding="0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                VerticalAlignment="Top" ToolTip="关闭">
                            <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                  Width="10" Height="10" Stretch="Uniform"
                                  Fill="{DynamicResource MaterialDesignBody}" Opacity="0.6"/>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Height="1" Opacity="0.7"
                            Background="{DynamicResource MaterialDesignDivider}"/>

                    <!-- 表单区 -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="22,16,22,8">
                            <TextBlock Text="快速填充" FontSize="11" Opacity="0.55" Margin="0,0,0,6"/>
                            <WrapPanel Name="PresetButtonsWrapPanel" Margin="0,2,0,14"/>

                            <TextBlock Text="供应商别名" FontSize="11" Opacity="0.55" Margin="0,0,0,5"/>
                            <TextBox Name="DialogNameTextBox" MinHeight="34" Padding="10,6" Margin="0,0,0,14"/>

                            <TextBlock Text="API 地址" FontSize="11" Opacity="0.55" Margin="0,0,0,5"/>
                            <TextBox Name="DialogBaseUrlTextBox" MinHeight="34" Padding="10,6"/>
                            <TextBlock Text="可以不写 /v1，请求失败时会自动补上再试一次。" FontSize="11"
                                       Opacity="0.45" Margin="2,4,0,14" TextWrapping="Wrap"/>

                            <TextBlock Text="API 密钥" FontSize="11" Opacity="0.55" Margin="0,0,0,5"/>
                            <PasswordBox Name="DialogApiKeyPasswordBox" MinHeight="34" Padding="10,6" Margin="0,0,0,16"/>

                            <!-- 模型：标题行 + 手动添加行 + 列表，列表不再套第二层边框 -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="模型" FontSize="11" Opacity="0.55" VerticalAlignment="Center"/>
                                <Button Name="DialogFetchModelsButton" Grid.Column="1" Content="从接口获取"
                                        Style="{DynamicResource MaterialDesignFlatButton}" FontSize="12"
                                        Padding="10,3" MinWidth="0"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="DialogNewModelTextBox" MinHeight="32" Padding="10,4" Margin="0,0,8,0"/>
                                <Button Name="DialogAddModelButton" Grid.Column="1" Content="添加"
                                        Style="{DynamicResource MaterialDesignFlatButton}" FontSize="12" Padding="12,3"/>
                            </Grid>

                            <Border MaxHeight="150" CornerRadius="8" Padding="4,2"
                                    Background="{DynamicResource MaterialDesignBackground}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Name="DialogModelsContainer" Margin="4,2"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 底部操作区：错误提示在左，按钮固定在右下角，不随内容滚动 -->
                    <Border Grid.Row="3" BorderThickness="0,1,0,0" Padding="22,12,20,14"
                            BorderBrush="{DynamicResource MaterialDesignDivider}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Name="DialogErrorTextBlock" Visibility="Collapsed"
                                       FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Margin="0,0,12,0"
                                       Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Name="DialogCancelButton" Content="取消" FontSize="12.5"
                                        Style="{DynamicResource MaterialDesignFlatButton}"
                                        Padding="14,5" Margin="0,0,8,0"/>
                                <Button Name="DialogSaveButton" Content="保存" FontSize="12.5"
                                        Padding="20,5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 浮动 Toast 轻提示 -->
        <Border Name="ToastBorder" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,20,0,0" CornerRadius="8"
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
                Padding="18,10">
            <TextBlock Name="ToastMessageTextBlock" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource MaterialDesignBody}"/>
        </Border>
    </Grid>
</ci:SettingsPageBase>
