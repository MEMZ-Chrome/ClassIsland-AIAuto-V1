<Window x:Class="ClassIsland.Automation.V1.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ClassIsland.Automation.Core.Models"
        xmlns:mdXaml="clr-namespace:MdXaml;assembly=MdXaml"
        Title="IslandAgent" Width="640" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <Window.Resources>
        <!-- 会话条目容器：悬停高亮。用样式触发器而不是代码设值，
             深浅主题切换时背景会自动跟随；选中项由代码覆盖为本地值，优先级高于触发器。 -->
        <Style x:Key="SessionItemBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="6,5,4,5"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MaterialDesignDivider}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 会话列表侧栏（仅多会话模式显示，可折叠） -->
        <Border Name="SessionSidebarBorder" Width="204" Margin="0,0,12,0" Visibility="Collapsed"
                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
                CornerRadius="10" Background="{DynamicResource MaterialDesignBackground}" Padding="10,10,10,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 头部：气泡图标 + 标题 + 会话数徽标 + 新建按钮 -->
                <Grid Margin="2,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12z"
                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"
                          Fill="{DynamicResource MaterialDesignBody}" Opacity="0.65"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="7,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="会话" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Name="SessionCountBadge" Margin="6,0,0,0" Padding="5,0" CornerRadius="7"
                                Background="{DynamicResource MaterialDesignDivider}" VerticalAlignment="Center">
                            <TextBlock Name="SessionCountText" Text="0" FontSize="10" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <Button Name="SidebarNewSessionButton" Grid.Column="2" Width="26" Height="26" Padding="0"
                            ToolTip="新建会话" VerticalAlignment="Center">
                        <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                              Width="12" Height="12" Stretch="Uniform"
                              Fill="{DynamicResource MaterialDesignBody}" Opacity="0.8"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Name="SessionListStackPanel"/>
                </ScrollViewer>

                <!-- 空状态：没有任何会话时的占位 -->
                <StackPanel Name="SessionEmptyState" Grid.Row="1" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Visibility="Collapsed">
                    <Path Data="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12z"
                          Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center"
                          Fill="{DynamicResource MaterialDesignBody}" Opacity="0.22"/>
                    <TextBlock Text="还没有会话" FontSize="11" Margin="0,7,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.45"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <!-- 头部说明、模型选择与状态 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="AI 助手" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="连续智能调课、课表问答与设置调整" FontSize="12"
                           Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.7" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- 对话界面模型快速切换下拉框 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Name="SidebarToggleButton" Content="会话列表" FontSize="12" Padding="12,2"
                        VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"/>
                <Button Name="NewSessionButton" FontSize="12" Margin="0,0,12,0"
                        VerticalAlignment="Center" Padding="10,2">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                              Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"
                              Margin="0,0,5,0" Fill="{DynamicResource MaterialDesignBody}"/>
                        <TextBlock Text="新建会话" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="当前模型:" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.7" Margin="0,0,6,0"/>
                <ComboBox Name="ModelSelectComboBox" MinWidth="180" MaxWidth="260" VerticalAlignment="Center" Height="28"/>
            </StackPanel>
        </Grid>

        <!-- 消息历史对话流（气泡式对话界面） -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
                CornerRadius="8" Background="{DynamicResource MaterialDesignBackground}" Padding="8">
            <ScrollViewer Name="ChatScrollViewer" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl Name="MessagesItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ChatMessageItem}">
                            <Grid Margin="0,6">
                                <!-- 用户消息气泡（右对齐） -->
                                <StackPanel HorizontalAlignment="Right" MaxWidth="460" Margin="30,0,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{Binding TimeString}" FontSize="11" Opacity="0.7"
                                               Foreground="{DynamicResource MaterialDesignBody}"
                                               HorizontalAlignment="Right" Margin="0,0,4,2"/>
                                    <Border Background="{DynamicResource PrimaryHueMidBrush}" CornerRadius="14,14,2,14" Padding="12,8">
                                        <TextBox Text="{Binding Content, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                 BorderThickness="0" Background="Transparent"
                                                 Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" FontSize="14"
                                                 Cursor="Arrow"/>
                                    </Border>
                                </StackPanel>

                                <!-- AI 助手消息气泡（左对齐，支持 Markdown 表格与富文本排版） -->
                                <StackPanel HorizontalAlignment="Left" MaxWidth="500" Margin="0,0,30,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <StackPanel Orientation="Horizontal" Margin="4,0,0,2">
                                        <TextBlock Text="AI 助手" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding TimeString}" FontSize="11"
                                                   Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.7"/>
                                    </StackPanel>
                                    <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                            BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
                                            CornerRadius="14,14,14,2" Padding="12,10">
                                        <StackPanel>
                                            <!-- 工具调用徽标 -->
                                            <ItemsControl ItemsSource="{Binding ToolBadges}">
                                                <ItemsControl.Style>
                                                    <Style TargetType="ItemsControl">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasToolBadges}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.Style>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource MaterialDesignPaper}"
                                                                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
                                                                CornerRadius="4" Padding="6,2" Margin="0,2">
                                                            <TextBlock Text="{Binding}" FontSize="11"
                                                                       Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.7"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- 消息文本（Markdown 富文本，包含表格、列表、加粗） -->
                                            <mdXaml:MarkdownScrollViewer
                                                Markdown="{Binding Content}"
                                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                IsToolBarVisible="False"
                                                Background="Transparent"
                                                Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 系统消息（居中） -->
                                <StackPanel HorizontalAlignment="Center" Margin="0,4">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="6" Padding="8,4">
                                        <TextBlock Text="{Binding Content}" FontSize="11"
                                                   Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.7" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 图片状态栏 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,6">
            <Button Name="SelectImageButton" Content="添加课表图片" Padding="8,4"/>
            <TextBlock Name="ImageStatusTextBlock" VerticalAlignment="Center"
                       Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.7" Text="未选择图片" Margin="8,0,8,0"/>
            <Button Name="ClearImageButton" Content="清除" Visibility="Collapsed" Padding="8,4"/>
        </StackPanel>

        <!-- 输入与发送（支持回车发送，Shift+Enter换行） -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox Name="InputTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         MinHeight="36" MaxHeight="120"
                         VerticalContentAlignment="Center" Padding="6"/>
                <TextBlock Name="InputWatermarkTextBlock" Text="请输入文本..." Opacity="0.5"
                           Foreground="{DynamicResource MaterialDesignBody}"
                           IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=InputTextBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Button Name="SendButton" Grid.Column="1" Content="发送" Margin="8,0,0,0" Padding="16,6"
                    VerticalAlignment="Bottom"/>
        </Grid>
        </Grid>
    </Grid>
</Window>
